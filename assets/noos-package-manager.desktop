[Desktop Entry]
Type=Application
Version=1.0
Name=Gestionnaire de paquets
Name[fr]=Gestionnaire de paquets
GenericName=Gestionnaire de paquets Arch Linux
Comment=Gestionnaire de paquets graphique moderne (Pacman, AUR, Flatpak/Flathub et AppImages) pour Arch Linux
Exec=/usr/bin/noos-package-manager
Icon=noos-package-manager
Terminal=false
Categories=System;PackageManager;GTK;GNOME;
Keywords=pacman;aur;yay;flatpak;flathub;appimage;arch;package;manager;noos;gestionnaire;paquets;
StartupNotify=true
StartupWMClass=org.noos.PackageManager
